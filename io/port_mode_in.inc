.ifdef DEF_PORT_MODE_IN
.else
.set DEF_PORT_MODE_IN = 1

.if REPORT_INCLUDES == 0x01
.message "included PORT_MODE_IN"
.endif

.include	"./io/_port_offset.inc"
.include	"./io/reg_bit_hi.inc"

;--------------------------------------------------------
PORT_MODE_IN:
;--------------------------------------------------------
;Устанвливаем порт на вход
;IN: ACCUM-порт
;--------------------------------------------------------
	CPI ACCUM,0xff
	BRNE PC+0x02
	RET

	PUSH_Z
	PUSH ACCUM
	PUSH TEMP
	MCALL _PORT_OFFSET
	ADIW ZL,0x01
	LPM TEMP,Z
	MCALL REG_BIT_LO
	POP TEMP
	POP ACCUM
	POP_Z
	RET
.endif
