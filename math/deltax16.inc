.ifdef DEF_DELTAX16
.else
.set DEF_DELTAX16 = 1

.if REPORT_INCLUDES == 0x01
.message "included DELTAx16"
.endif

;--------------------------------------------------------
DELTAX16:
;--------------------------------------------------------
;Нахождение разницы |X-Z|
;IN: X, Z
;OUT: X
;--------------------------------------------------------
	SUB XL,ZL
	SBC XH,ZH
	BRCC _DELTAX16__END
	COM XL
	COM XH
	ADIW XL,0x01
_DELTAX16__END:
	RET
.endif
